# ==============================================================================
# GeoReckon Server Configuration Template (.env.example)
# Copy this file to .env and configure for your deployment environment.
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=5000

# Security & Session Configuration
SECRET_KEY=replace_with_a_secure_random_key_in_production

# KinoNet Model Weights Location
# Provide the absolute path to kinonet_r2_best.pth on your host or EC2 instance
KINONET_WEIGHTS=./InertiaX/kinonet_r2_best.pth

# Deployment Environment ('production' or 'development')
ENVIRONMENT=production

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=*
